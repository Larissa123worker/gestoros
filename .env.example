# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-random-secret
# App
EXPO_PUBLIC_APP_ID=Kito-Ordem
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://your-oauth-portal.com
EXPO_PUBLIC_OAUTH_SERVER_URL=http://localhost:3000
EXPO_PUBLIC_OWNER_OPEN_ID=owner-open-id
EXPO_PUBLIC_OWNER_NAME=Owner Name
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server
JWT_SECRET=replace-with-a-random-secret
DATABASE_URL=mysql://user:pass@localhost:3306/db
NODE_ENV=development
PORT=3000

# Asaas (server only; never expose these as EXPO_PUBLIC variables)
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT_MS=60000

# Supabase Edge Functions only
RESEND_API_KEY=
RESEND_FROM=Gestor OS <noreply@seudominio.com>

# WhatsApp Cloud API oficial da Meta (Supabase Edge Function only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TEMPLATE_NAME=phone_verification
WHATSAPP_VERIFY_TEMPLATE_LANGUAGE=pt_BR

# Optional: Forge (legacy)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
